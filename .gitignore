.idea/
.vscode/
*.swp
*.swo
*~
.zed/
.fleet/

# Frontend dependencies and builds
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env.local
frontend/.env.*.local
frontend/*.tsbuildinfo
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
